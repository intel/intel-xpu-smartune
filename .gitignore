# Ignore all of .idea folder by default for pycharm
.idea/*

*.pyc
__pycache__/

# SSL certificates
key/

# Database files
my_database.db
my_database.db-shm
my_database.db-wal

# Logs
logs/

config/runtime_state.json

# deb packaging build output
/build/

# Benchmark runtime tree: venv, downloaded models, IR, logs, generated run
# scripts. Multi-GB and fully reproducible from setup_env.sh.
benchmark/runtime/
benchmark/.generated_run_*.sh
benchmark/**/__pycache__/
# Fallback location for search_models.py's caches when it is run standalone
# (a configured service writes them under the runtime tree instead).
benchmark/service/models_cache*.json
